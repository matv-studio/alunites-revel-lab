---
layout: layouts/base.njk
permalink: /agence/
bodyClass: page-agence
---
{%- set a = pages.agence -%}
<header class="page-hero page-hero--agence">
  <div class="page-hero__inner">
    <h1 class="page-hero__title">{{ a.title | accent | safe }}</h1>
    <div class="page-hero__text prose prose--large">{{ a.intro | safe }}</div>
  </div>
</header>

{% include "partials/numbers.njk" %}

<section class="story" data-theme="light" aria-labelledby="story-title">
  <div class="story__inner">
    <header class="story__head">
      <h2 class="section-title" id="story-title">{{ a.story_title }}</h2>
      <p class="aside">{{ a.story_subtitle }}</p>
    </header>
    <div class="story__media">{% image a.story_image, "Les locaux d'Alunites à Lyon", "(min-width: 900px) 50vw, 92vw", "story__img", "3 / 2" %}</div>
    <div class="story__text">
      <div class="lead">{{ a.story_lead | safe }}</div>
      <div class="prose">{{ a.story_text | safe }}</div>
    </div>
  </div>
</section>

<section class="values" aria-labelledby="values-title">
  <div class="values__inner">
    <header class="section-head section-head--stack">
      <h2 class="section-title" id="values-title">{{ a.values_title | accent | safe }}</h2>
      <p class="aside">{{ a.values_subtitle }}</p>
    </header>
    <ul class="values__list">
      {%- for v in a.values %}
      <li class="values__item"><h3 class="values__title">{{ v.title }}<em class="accent">.</em></h3><div class="prose">{{ v.body | safe }}</div></li>
      {%- endfor %}
    </ul>
  </div>
</section>

{% include "partials/clients.njk" %}

{#- « Les pépites d'Alunites » : même bandeau défilant que les logos clients.
    La liste est écrite deux fois (la copie est masquée aux lecteurs d'écran) pour une boucle sans à-coup. -#}
{%- set teamSizes = "(min-width: 601px) 270px, 172px" %}
<section class="team" id="equipe" aria-labelledby="team-title">
  <div class="team__inner">
    <header class="marquee-head">
      <h2 class="section-title" id="team-title">{{ a.team_title | accent | safe }}</h2>
      <button type="button" class="marquee-toggle" data-marquee-toggle aria-pressed="false" aria-controls="team-marquee">Mettre en pause</button>
    </header>
  </div>
  <div class="marquee marquee--team" id="team-marquee" data-marquee style="--count:{{ collections.equipe.length }}">
    <ul class="marquee__track">
      {%- for pass in [1, 2] %}
      {%- for p in collections.equipe %}
      <li class="marquee__item person"{% if pass == 2 %} aria-hidden="true"{% endif %}>
        <span class="person__photo{% if p.data.photo_hover %} person__photo--swap{% endif %}">
          {% image p.data.photo, (p.data.name if pass == 1 else ""), teamSizes, "person__img", "4 / 5" %}
          {% imageOptional p.data.photo_hover, "", teamSizes, "person__img person__img--hover", "4 / 5" %}
        </span>
        <span class="person__name">{{ p.data.name | personName }}</span>
        {%- if p.data.job %}<span class="person__job">{{ p.data.job }}</span>{% endif %}
        {%- if p.data.quote %}<span class="person__quote">{{ p.data.quote }}</span>{% endif %}
      </li>
      {%- endfor %}
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="jobs" id="rejoindre" data-theme="light" aria-labelledby="jobs-title">
  <div class="jobs__inner">
    <header class="section-head section-head--stack">
      <h2 class="section-title" id="jobs-title">{{ a.jobs_title | accent | safe }}</h2>
      <p class="aside">{{ a.jobs_subtitle }}</p>
    </header>
    {%- if collections.offres.length %}
    <ul class="jobs__list">
      {%- for j in collections.offres %}
      <li><a class="jobs__item" href="{{ j.data.pdf }}" target="_blank" rel="noopener"><span class="jobs__title">{{ j.data.title }}</span><span class="jobs__meta">Fiche de poste (PDF)</span></a></li>
      {%- endfor %}
    </ul>
    {%- else %}
    <p>Aucune offre en ce moment. Candidature spontanée : <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    {%- endif %}
  </div>
</section>

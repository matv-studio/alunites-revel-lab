---
layout: layouts/base.njk
bodyClass: page-entry
---
{%- set heroTags = [] -%}
{%- for slug in expertises -%}{%- set ex = collections.expertises | bySlug(slug) -%}{%- if ex -%}
{%- set heroTags = (heroTags.push({ label: ex.data.title, url: ex.url, color: expertiseColors[ex.data.color] }), heroTags) -%}
{%- endif -%}{%- endfor -%}
{%- set kickerHtml = ("pour <strong>" + client + "</strong>") if client else "" -%}
<article class="entry">
  {% include "partials/entry-header.njk" %}
  {% include "partials/blocks.njk" %}
</article>
{%- set others = (collections.projets | bySlugs(suggestions)) if suggestions and suggestions.length else [] -%}
{%- if others.length < 3 %}{% set others = collections.projets | without(page.url) | limit(3) %}{% endif %}
<section class="related" aria-labelledby="related-title">
  <div class="section-head">
    <h2 class="section-title" id="related-title">Découvrez nos <em class="accent">autres projets</em></h2>
    <a class="text-link" href="/projets/">Tous les projets</a>
  </div>
  <div class="grid grid--3">
    {%- for item in others | limit(3) %}{% include "partials/card-project.njk" %}{% endfor %}
  </div>
</section>

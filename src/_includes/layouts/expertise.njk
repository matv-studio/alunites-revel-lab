---
layout: layouts/base.njk
bodyClass: page-expertise
---
{%- set color = expertiseColors[color] -%}
<article class="expertise" style="--expertise:{{ color }}">
  <header class="expertise-hero">
    <div class="expertise-hero__inner">
      {%- set rosaceClass = "expertise-hero__rosace" %}{% include "partials/rosace.svg.njk" %}
      <p class="expertise-hero__kicker"><a href="/agence/">notre expertise</a></p>
      <h1 class="expertise-hero__title">{{ title }}</h1>
      <div class="expertise-hero__grid">
        <div class="prose prose--large">{{ introduction | safe }}</div>
        {%- if sectors.length %}
        <div class="sectors">
          <h2 class="sectors__title">{{ sectors_title | lower }}</h2>
          <ul class="sectors__list">{% for s in sectors %}<li>{{ s }}</li>{% endfor %}</ul>
        </div>
        {%- endif %}
      </div>
    </div>
  </header>

  {%- if video %}
  <section class="expertise-video">
    {%- set label = title %}{% set videoClass = "video--wide" %}{% set cover = video_cover %}
    {% include "partials/video.njk" %}
  </section>
  {%- endif %}

  {%- if activities.length %}
  <section class="activities" data-theme="light" aria-labelledby="activities-title">
    <div class="activities__inner">
      <h2 class="section-title" id="activities-title">{{ activities_title | accent | safe }}</h2>
      <dl class="activities__list">
        {%- for a in activities %}
        <div class="activities__item">
          <dt>{{ a.title | lower }}</dt>
          <dd class="prose">{{ a.body | safe }}</dd>
        </div>
        {%- endfor %}
      </dl>
    </div>
  </section>
  {%- endif %}

  {%- if formats.length %}
  <section class="formats" aria-label="Formats">
    <ul class="formats__list">
      {%- for f in formats %}
      <li class="formats__item">{% if f.icon and (f.icon | mediaExists) %}<img src="{{ f.icon }}" alt="" width="56" height="56" loading="lazy">{% else %}<span class="formats__icon-placeholder" aria-hidden="true"></span>{% endif %}<span>{{ f.title | lower }}</span></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {%- set person = collections.equipe | bySlug(contact_person) %}
  {%- if contact_quote %}
  <section class="expertise-contact">
    <div class="expertise-contact__inner">
      <blockquote class="expertise-contact__quote">{{ contact_quote }}</blockquote>
      {%- if person %}
      <div class="person person--inline">
        <span class="person__photo">{% image person.data.photo, person.data.name, "160px", "person__img", "1 / 1" %}</span>
        <span><strong class="person__name">{{ person.data.name }}</strong><span class="person__job">{{ person.data.job }}</span></span>
      </div>
      {%- endif %}
      <a class="button" href="/contact/">Parlons de votre projet</a>
    </div>
  </section>
  {%- endif %}

  {%- set related = collections.projets | withExpertise(slug) %}
  {%- set picked = (collections.projets | bySlugs(suggestions)) if suggestions and suggestions.length else [] %}
  {%- if picked.length < 3 %}{% set picked = related %}{% endif %}
  {%- if picked.length %}
  <section class="related" aria-labelledby="related-title">
    <div class="section-head">
      <h2 class="section-title" id="related-title">Nos projets <em class="accent">{{ title }}</em></h2>
      <a class="text-link" href="/projets/?expertise={{ slug }}">Tous les projets {{ title }}</a>
    </div>
    <div class="grid grid--3">{% for item in picked | limit(3) %}{% include "partials/card-project.njk" %}{% endfor %}</div>
  </section>
  {%- endif %}

  <nav class="expertise-nav" aria-label="Autres expertises">
    <ul>
      {%- for e in collections.expertises %}{% if e.url != page.url %}
      <li><a href="{{ e.url }}" style="--dot:{{ expertiseColors[e.data.color] }}"><span class="dot"></span>{{ e.data.title }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
  </nav>
</article>

{%- set pageTitle = seo | seoTitle(site) -%}
{%- set pageDescription = (seo and seo.description) or site.description -%}
{%- set canonical = page.url | absoluteUrl(site.url) -%}
{%- set shareSrc = (seo and seo.image) or cover or site.share_image -%}
{%- set ogImage = shareSrc | shareImage(site.url) -%}
<!doctype html>
<html lang="{{ site.lang }}" data-theme="{{ theme or 'dark' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="robots" content="{{ 'noindex, nofollow' if env.staging else ('noindex, follow' if noindex else 'max-image-preview:large') }}">
  <link rel="canonical" href="{{ canonical }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ canonical }}">
  {%- if ogImage %}
  <meta property="og:image" content="{{ ogImage }}">
  {%- endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  {%- if ogImage %}
  <meta name="twitter:image" content="{{ ogImage }}">
  {%- endif %}
  {%- if ogType == 'article' %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  {%- endif %}
  <meta name="theme-color" content="#16171B">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="alternate" type="application/rss+xml" title="Actualités Alunites" href="/feed.xml">
  <link rel="preload" href="/assets/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/site.css?v={{ version }}">
  {% include "partials/jsonld.njk" %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#contenu">Aller au contenu</a>
  {% include "partials/header.njk" %}
  <main id="contenu" tabindex="-1">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {%- if env.staging %}
  <p class="env-badge" role="note">Version de recette, non publique</p>
  {%- else %}
  {% include "partials/consent.njk" %}
  {%- endif %}
  <script src="/assets/js/site.js?v={{ version }}" defer></script>
</body>
</html>

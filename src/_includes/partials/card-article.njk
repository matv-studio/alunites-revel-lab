{#- Carte actualité : item = page de la collection actualites -#}
<article class="card card--article" data-categories="{{ item.data.categories | join(' ') }}">
  <a class="card__link" href="{{ item.url }}">
    <span class="card__media">{% image item.data.cover, item.data.cover_alt or "", "(min-width: 1100px) 30vw, (min-width: 700px) 45vw, 92vw", "card__img", "16 / 10" %}</span>
    <span class="card__body">
      <time class="card__kicker" datetime="{{ item.data.display_date or item.data.date }}">{{ (item.data.display_date or item.data.date) | dateFr }}</time>
      <span class="card__title">{{ item.data.title }}</span>
    </span>
  </a>
  {%- if item.data.categories and item.data.categories.length %}
  <ul class="tags" aria-label="Catégories">
    {%- for slug in item.data.categories %}{% set cat = rubriques.items | findCategory(slug) %}{% if cat %}
    <li class="tag" style="--dot:{{ expertiseColors[cat.color] }}">{{ cat.name }}</li>
    {%- endif %}{% endfor %}
  </ul>
  {%- endif %}
</article>

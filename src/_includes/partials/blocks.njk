{#- Flux de blocs d'un projet / d'une actualité -#}
<div class="blocks">
{%- for b in blocks %}
  {%- if b.type == "text" %}
  <section class="block block--text"><div class="prose">{{ b.body | safe }}</div></section>
  {%- elif b.type == "quote" %}
  <figure class="block block--quote">
    <blockquote class="quote">{{ b.quote | safe }}</blockquote>
    {%- if b.author %}<figcaption class="quote__author">{{ b.author | safe }}</figcaption>{% endif %}
  </figure>
  {%- elif b.type == "image" %}
  <figure class="block block--image block--{{ b.style or 'fullscreen' }}">
    {% image b.image, b.alt or "", ("100vw" if b.style != "column" else "(min-width: 900px) 760px, 92vw"), "block__img" %}
  </figure>
  {%- elif b.type == "slider" %}
  <section class="block block--slider" aria-label="Galerie d'images" data-slider>
    <div class="slider__track" tabindex="0" data-slider-track>
      {%- for src in b.images %}
      <figure class="slider__item">{% image src, "", "(min-width: 900px) 60vw, 85vw", "slider__img" %}</figure>
      {%- endfor %}
    </div>
    {%- if b.images.length > 1 %}
    <div class="slider__controls">
      <button type="button" class="round-button" data-slider-prev aria-label="Image précédente"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
      <span class="slider__count" aria-live="polite" data-slider-count>1 / {{ b.images.length }}</span>
      <button type="button" class="round-button" data-slider-next aria-label="Image suivante"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/></svg></button>
    </div>
    {%- endif %}
  </section>
  {%- elif b.type == "video" %}
  <section class="block block--video block--{{ b.style or 'fullscreen' }}">
    {%- set video = b.video %}{% set cover = b.cover %}{% set label = title %}{% set videoClass = "" %}
    {% include "partials/video.njk" %}
  </section>
  {%- endif %}
{%- endfor %}
</div>

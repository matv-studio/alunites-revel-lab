{#- Lecteur vidéo : video (URL Vimeo directe .mp4, page Vimeo ou YouTube), cover, label -#}
{%- set vid = video or "" -%}
{%- set isFile = ("progressive_redirect" in vid) or (".mp4" in vid) -%}
<figure class="video {{ videoClass }}" data-video>
  {%- if isFile %}
  <video class="video__el" src="{{ vid }}" preload="none" playsinline controls hidden{% if cover %} poster="{{ cover }}"{% endif %}></video>
  {%- else %}
  <template data-video-embed>
    {%- if "youtu" in vid %}
    <iframe class="video__el" src="https://www.youtube-nocookie.com/embed/{{ vid | youtubeId }}?autoplay=1&rel=0" title="{{ label or 'Vidéo' }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
    {%- else %}
    <iframe class="video__el" src="https://player.vimeo.com/video/{{ vid | vimeoId }}?autoplay=1&dnt=1" title="{{ label or 'Vidéo' }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
    {%- endif %}
  </template>
  {%- endif %}
  <button class="video__cover" type="button" data-video-play aria-label="Lire la vidéo{% if label %} : {{ label }}{% endif %}">
    {% image cover, "", "(min-width: 1200px) 1200px, 100vw", "video__poster", "16 / 9" %}
    <span class="video__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
  </button>
</figure>

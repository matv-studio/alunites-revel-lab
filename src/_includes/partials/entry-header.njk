{#- En-tête commun projet / actualité. kicker = « pour Client » ou date -#}
<header class="entry-hero">
  <div class="entry-hero__media">{% image cover, cover_alt or "", "100vw", "entry-hero__img", "", "eager" %}</div>
  <div class="entry-hero__text">
    {%- if kickerHtml %}<p class="entry-hero__kicker">{{ kickerHtml | safe }}</p>{% endif %}
    <h1 class="entry-hero__title">{{ title }}</h1>
    {%- if heroTags and heroTags.length %}
    <ul class="tags tags--hero">
      {%- for t in heroTags %}<li class="tag" style="--dot:{{ t.color }}">{% if t.url %}<a href="{{ t.url }}">{{ t.label }}</a>{% else %}{{ t.label }}{% endif %}</li>{% endfor %}
    </ul>
    {%- endif %}
  </div>
</header>
{%- if hook.length or chapeau or intro or keywords.length %}
<section class="entry-intro" data-theme="light">
  <div class="entry-intro__inner">
    {%- if hook.length %}
    <p class="entry-intro__hook">{% for line in hook %}<span>{{ line }}</span>{% endfor %}</p>
    {%- endif %}
    <div class="entry-intro__grid">
      {%- if chapeau %}<div class="entry-intro__lead">{{ chapeau | safe }}</div>{% endif %}
      <div class="entry-intro__text">
        {%- if intro %}<div class="prose">{{ intro | safe }}</div>{% endif %}
        {%- if keywords.length %}
        <ul class="keywords" aria-label="Mots-clés">{% for k in keywords %}<li>{{ k }}</li>{% endfor %}</ul>
        {%- endif %}
        {%- if link %}<p><a class="text-link" href="{{ link }}" rel="noopener" target="_blank">En savoir plus</a></p>{% endif %}
      </div>
    </div>
  </div>
</section>
{%- endif %}

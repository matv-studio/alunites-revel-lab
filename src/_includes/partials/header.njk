{%- set nav = [
  { url: "/agence/", label: "Agence" },
  { url: "/projets/", label: "Projets" },
  { url: "/actualites/", label: "Actualités" },
  { url: "/contact/", label: "Contact" }
] -%}
<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Alunites, retour à l'accueil">{% include "partials/logo.svg.njk" %}</a>
    <nav class="site-nav" aria-label="Navigation principale">
      <ul class="site-nav__list">
        {%- for item in nav %}
        <li><a class="site-nav__link" href="{{ item.url }}"{% if (page.url or "").startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
      <span class="menu-toggle__label">Menu</span>
      <span class="menu-toggle__icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>
  <div class="menu" id="menu" hidden data-menu>
    <div class="menu__inner">
      <ul class="menu__main">
        <li><a href="/">Accueil</a></li>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if (page.url or "").startsWith(item.url) %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
      <div class="menu__side">
        <p class="menu__heading">Nos expertises</p>
        <ul class="menu__expertises">
          {%- for e in collections.expertises %}
          <li><a href="{{ e.url }}"><span class="dot" style="--dot:{{ expertiseColors[e.data.color] }}"></span>{{ e.data.title }}</a></li>
          {%- endfor %}
        </ul>
        <p class="menu__contact"><a href="mailto:{{ site.email }}">{{ site.email }}</a><br><a href="tel:{{ site.phone | replace(' ', '') | replace('(0)', '') }}">{{ site.phone }}</a></p>
      </div>
    </div>
  </div>
</header>

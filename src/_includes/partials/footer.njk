{%- if not hideFooterCta %}
<section class="cta-band" aria-labelledby="cta-title">
  <div class="cta-band__inner">
    {%- set rosaceClass = "cta-band__rosace" %}{% include "partials/rosace.svg.njk" %}
    <h2 class="cta-band__title" id="cta-title">{{ site.contact_cta.title | accent | safe }}</h2>
    <p class="cta-band__aside">{{ site.contact_cta.subtitle }}</p>
    <p class="cta-band__text">{{ site.contact_cta.text }}</p>
    <a class="button button--light" href="/contact/">{{ site.contact_cta.button }}</a>
  </div>
</section>
{%- endif %}
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" aria-label="Alunites, retour à l'accueil">{% include "partials/logo.svg.njk" %}</a>
      <address class="site-footer__address">
        <a href="https://maps.google.com/?q={{ (site.address.street + ' ' + site.address.postcode + ' ' + site.address.city) | urlencode }}" rel="noopener">{{ site.address.street }}<br>{{ site.address.postcode }} {{ site.address.city | upper }}</a>
      </address>
      <p class="site-footer__contact">
        <a href="tel:{{ site.phone | replace(' ', '') | replace('(0)', '') }}">T. {{ site.phone }}</a><br>
        <span>F. {{ site.fax }}</span><br>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
      </p>
    </div>
    <nav class="site-footer__nav" aria-label="Plan du site">
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/agence/">Agence</a></li>
        <li><a href="/projets/">Projets</a></li>
        <li><a href="/actualites/">Actualités</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>
    <nav class="site-footer__nav" aria-labelledby="footer-expertises">
      <p class="site-footer__heading" id="footer-expertises">nos expertises</p>
      <ul>
        {%- for e in collections.expertises %}
        <li><a href="{{ e.url }}">{{ e.data.title }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <div class="site-footer__social">
      <p class="site-footer__heading">suivez-nous</p>
      <ul>
        <li><a href="{{ site.social.linkedin }}" rel="noopener" target="_blank">LinkedIn</a></li>
        <li><a href="{{ site.social.instagram }}" rel="noopener" target="_blank">Instagram</a></li>
        <li><a href="{{ site.social.youtube }}" rel="noopener" target="_blank">YouTube</a></li>
        <li><a href="{{ site.social.facebook }}" rel="noopener" target="_blank">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="site-footer__legal">
    <p>© {{ "" | year }} Alunites. Tous droits réservés.</p>
    <p><a href="/mentions-legales/">Mentions légales</a> <button type="button" class="link-button" data-consent-open>Gérer les cookies</button></p>
  </div>
</footer>

---
layout: layouts/base.njk
permalink: /actualites/
bodyClass: page-list
---
<header class="list-head">
  <h1 class="page-title">{{ pages.actualites.title | accent | safe }}</h1>
  <div class="filters" role="group" aria-label="Filtrer par rubrique" data-filters data-filter-attr="categories" data-filter-param="rubrique">
    <button type="button" class="filter is-active" data-filter="" aria-pressed="true">toutes les actualités</button>
    {%- for c in rubriques.items %}
    <button type="button" class="filter" data-filter="{{ c.slug }}" aria-pressed="false" style="--dot:{{ expertiseColors[c.color] }}"><span class="dot"></span>{{ c.name }}</button>
    {%- endfor %}
  </div>
</header>
<div class="grid grid--3 list-grid" data-filter-list>
  {%- for item in collections.actualites %}{% include "partials/card-article.njk" %}{% endfor %}
</div>
<p class="list-empty" hidden data-filter-empty>Aucune actualité dans cette rubrique.</p>
